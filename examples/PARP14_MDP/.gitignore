# Simulation outputs — large binary files, regenerable
*.dcd
*.chk
checkpoint.pdb
top.pdb
default_simulation*.pdb
run.log

# Per-replicate simulation directories (auto-generated by prepare scripts)
fl/seed-*_sample-*/
fl_optimized/seed-*_sample-*/
md/seed-*_sample-*/
mka/seed-*_sample-*/
core/seed-*_sample-*/
norrm/seed-*_sample-*/
noart/seed-*_sample-*/
md3art/seed-*_sample-*/
parp14/parp14_seed-*_sample-*/
parp14/seed-*_sample-*/
parp14_10/
restraint_tests/*/seed-*_sample-*/
restraint_tests/*/default_simulation*
restraint_tests/*/*.chk
restraint_tests/*/checkpoint.pdb
restraint_tests/*/top.pdb
restraint_tests/_run_logs/

# Fragment simulations (1200 sim dirs)
fragments/*/seed-*_sample-*/
fragments/_run_logs/

# Restraint test caches and trajectories
restraint_tests/*.dcd
restraint_tests/*.chk

# Analysis caches (large npz / npy files)
data/
data_5ns/
restraint_tests/summary_plots/*.png
restraint_tests/summary_plots/*.pdf

# Figures (rendered output)
figures/
figures_5ns/
*.pse
pymol_frames/
renders/

# Editor backups
.*.swp

# Top-level simulation set dirs (only their input/ and metadata are
# tracked; sim subdirs and outputs are ignored above)
# Keep these listed so git status doesn't show them as untracked
core/seed-*
fl/seed-*
md/seed-*
mka/seed-*
norrm/seed-*
noart/seed-*
md3art/seed-*
fragments/*/seed-*

# Fragments that haven't had their metadata committed yet
fragments/rrm1_rrm2_rrm3_kh1-kh6_kh7a_md1l1_md2_md3_khb-kh8_wwe_art/

# Old / stale snapshot dirs
parp14_10/
fragments/launch_commands.txt~

# Output of analysis scripts
parp14_accessibility.pse
fl_movie.pse

# ------------------------------------------------------------------
# complex/ -- the PARP9/DTX3L binding campaign
# Results ARE tracked so they can be used from any machine: analysis/
# (CSVs, figures, representative state PDBs), the scripts, and the
# shared per-set input/. Trajectories and per-replicate machine state
# are not -- *.dcd and *.chk are excluded above, and 39 GB of them sit
# on disk here.
# ------------------------------------------------------------------

# Figures under complex/ are results, not scratch -- override the blanket
# figures/ rule above.
!complex/analysis/figures/
!complex/analysis/figures/**

# Per-replicate state written by the run scripts: serialised OpenMM systems
# (~2.6 MB each), the restraint/bond dumps, and dated snapshot PDBs. All are
# regenerable from the prepare script plus the tracked input/ directory.
complex/*/*/rep-*/*.xml
complex/*/*/rep-*/bonds_*.txt
complex/*/*/rep-*/restr_*.txt
complex/*/*/rep-*/*_2026*.pdb
complex/*/*/rep-*/*.log
complex/*/*/rep-*/*.complete

# HyRes run outputs (trajectories excluded above; these are bulk per-run state)
complex/hyres/runs/**/*.psf
complex/hyres/runs/**/system.pdb

# HyRes conversion intermediates: every stage convert.sh writes on the way
# (_fix, _H, _Hn, _cg, _cg2, _cgH and their _dock_ twins). Regenerable, and
# only the final *_hyres.pdb pair defines the runs.
complex/hyres/runs/prep/*.pdb
!complex/hyres/runs/prep/*_hyres.pdb

# Upstream HyRes force field, cloned in place as its own git repo. Tracking it
# here would write a gitlink that clones cannot resolve. Get it with:
#   git clone https://github.com/lslumass/HyRes_GPU.git \
#       examples/PARP14_MDP/complex/hyres/HyRes_GPU
# Pinned at ff02ac1. See complex/hyres/runs/prod_rep1/README.md for the four
# upstream bugs that must be worked around.
complex/hyres/HyRes_GPU/

# complex/data/ is source data, not the npz analysis cache the data/ rule
# above targets: the published crosslink table and the checks that read it.
!complex/data/
!complex/data/**
complex/data/__pycache__/

# Per-set setup metadata written by prepare_binding.py: box, concentration,
# restraint summary and the source AF3 model for each component. Results, not
# scratch -- override the root *.json rule.
!complex/binding*/*/binding_summary.json

# binding.tar.gz was a 43 MB snapshot of binding/ taken before those configs
# were tracked individually. Every one of its 2,027 files is now in the repo
# in its own right, so it was removed. It stays in git history; nothing should
# recreate it.
complex/binding.tar.gz
