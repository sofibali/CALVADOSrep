# Run artifacts. Everything here is regenerated by run.py on every launch, so
# none of it belongs in git -- the OpenMM system dumps alone are ~40 MB per
# construct (parp14_core_full_go.xml is 42 MB).
#
# Note: some of these were already committed before this file existed. To stop
# tracking them without deleting them from disk:
#     git rm --cached examples/PARP14_MDP/slab/*/*/*.xml
#     git rm --cached examples/PARP14_MDP/slab/*/*/.slab.lock
#
# The things that DO belong in git are the inputs: config.yaml,
# components.yaml, run.py, slab_meta.yaml and input/.

# OpenMM serialised system (regenerated at build_system)
*.xml

# trajectories, checkpoints, restart state
*.dcd
*.chk
top.pdb
checkpoint.pdb
equilibration_final.pdb

# per-run tables written at setup
bonds_*.txt
restr_*.txt

# reporter logs and final frames
*.log
parp14*_[0-9]*.pdb
backup_*.dcd

# launcher lock files
.slab.lock

# RNA-arm setup tables (regenerated per run)
angles_*.txt
basebase_*.txt

# NFS silly-rename leftovers
.nfs*

# SlabAnalysis intermediates (regenerated by analyze_slab.py; the per-frame
# profile arrays are ~7 MB each). The small *_ps_results.csv IS the result --
# it carries c_dilute (c_sat) and the interface cutoffs -- so it stays tracked.
*_profiles.npy
*_protein_profile.npy
*_protein_dense_array.npy
*_protein_dilute_array.npy
*_centered.dcd
